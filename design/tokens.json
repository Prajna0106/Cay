{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Cay Design Tokens",
  "version": "1.0.0",
  "colors": {
    "island": {
      "background": "#06061A",
      "border": "#5864F0",
      "border_alpha": 0.32,
      "border_width": 1,
      "shadow": "0 18px 40px rgba(6, 6, 26, 0.36)",
      "glass": {
        "enabled": true,
        "background": "#06061A",
        "background_alpha": 0.78,
        "border": "#B4C8FF",
        "border_alpha": 0.20,
        "border_width": 1.0,
        "card_alpha": 0.60,
        "card_border_alpha": 0.15
      }
    },
    "card": {
      "surface": "#0D0D22",
      "radius": 22
    },
    "track": {
      "background": "#15152A"
    },
    "text": {
      "primary": "#F5F5F7",
      "secondary": "#D4D4D8",
      "muted": "#48487E"
    },
    "accent": {
      "default": "#3DD8FF",
      "presets": {
        "sky": "#3DD8FF",
        "lime": "#74FF38",
        "warm": "#FF9A47",
        "purple": "#BF72FF"
      }
    },
    "semantic": {
      "timer": "#FF9A47",
      "warning": "#FF9A47",
      "cal_accent": "#3DD8FF"
    }
  },
  "typography": {
    "fonts": {
      "ui": "Inter, system-ui, sans-serif",
      "heading": "Space Grotesk, Inter, sans-serif"
    },
    "styles": {
      "card_title": {
        "font_size": 15,
        "font_weight": 600,
        "line_height": 1.2
      },
      "primary_line": {
        "font_size": 14,
        "font_weight": 600,
        "line_height": 1.2
      },
      "body": {
        "font_size": 13,
        "font_weight": 400,
        "line_height": 1.3
      },
      "meta": {
        "font_size": 12,
        "font_weight": 400,
        "line_height": 1.3
      },
      "caps_label": {
        "font_size": 11,
        "font_weight": 600,
        "letter_spacing": 0.8,
        "text_transform": "uppercase"
      },
      "timer_display": {
        "font_size": 16,
        "font_weight": 600,
        "font_variant_numeric": "tabular-nums"
      }
    }
  },
  "layout": {
    "top_offset": 14,
    "min_touch_target": 44,
    "icon_stroke_width": 1.8
  },
  "states": {
    "idle": {
      "width": 200,
      "height": 40,
      "radius": 20,
      "description": "Clock and battery percentage"
    },
    "now_playing": {
      "width": 360,
      "height": 46,
      "radius": 23,
      "album_art_size": 30,
      "album_art_radius": 9,
      "waveform_bars": 5,
      "description": "Album art, track title, artist, live waveform"
    },
    "notification": {
      "width": 440,
      "height": 78,
      "radius": 30,
      "app_icon_size": 44,
      "app_icon_radius": 14,
      "display_duration_secs": 5.0,
      "description": "App icon, title, sender, message preview"
    },
    "upcoming_event": {
      "width": 400,
      "height": 62,
      "radius": 31,
      "date_tile_size": 38,
      "date_tile_radius": 12,
      "lead_time_minutes": 15,
      "description": "Date tile, event title, countdown, Join button"
    },
    "timer": {
      "width": 280,
      "height": 46,
      "radius": 23,
      "description": "Timer/focus label and countdown"
    },
    "hud": {
      "width": 300,
      "height": 46,
      "radius": 23,
      "display_duration_secs": 2.0,
      "description": "Volume or brightness flyout replacement"
    },
    "hub": {
      "width": 820,
      "height": 330,
      "radius": 40,
      "padding": 18,
      "card_gap": 12,
      "description": "Expanded 3-card hub: Now Playing, Today events, Recent notifications"
    }
  },
  "motion": {
    "pill_morph": {
      "spring_duration_ms": 450,
      "spring_bounce": 0.2,
      "bezier_curve": [0.34, 1.4, 0.5, 1.0],
      "properties": ["width", "height", "border-radius"]
    },
    "content_fade": {
      "duration_ms": 350,
      "scale_from": 0.96,
      "scale_to": 1.0,
      "easing": "ease"
    },
    "reduced_motion": {
      "overshoot": false,
      "scale_animation": false,
      "fade_only": true,
      "duration_ms": 250
    }
  }
}
